{
  "components": {
    "schemas": {
      "Citation": {
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": ["title", "path"],
        "title": "Citation",
        "type": "object"
      },
      "ConversationCreate": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional; missing or blank becomes \"New conversation\". At most 200 UTF-16 units after trimming (an emoji counts 2); no control characters.",
            "title": "Title"
          }
        },
        "title": "ConversationCreate",
        "type": "object"
      },
      "ConversationDetail": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "messages": {
            "description": "Oldest first.",
            "items": {
              "$ref": "#/components/schemas/MessageOut"
            },
            "title": "Messages",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "created_at", "updated_at", "messages"],
        "title": "ConversationDetail",
        "type": "object"
      },
      "ConversationList": {
        "properties": {
          "count": {
            "description": "Number of items in this response (at most `limit`).",
            "title": "Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ConversationSummary"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": ["items", "count"],
        "title": "ConversationList",
        "type": "object"
      },
      "ConversationOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "created_at", "updated_at"],
        "title": "ConversationOut",
        "type": "object"
      },
      "ConversationSummary": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "updated_at"],
        "title": "ConversationSummary",
        "type": "object"
      },
      "ErrorBody": {
        "description": "The one error shape every api response uses.",
        "properties": {
          "error": {
            "description": "Stable snake_case code, e.g. not_found, validation_error.",
            "title": "Error",
            "type": "string"
          },
          "trace_id": {
            "description": "The request's trace id — the same value as the x-trace-id header.",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": ["error", "trace_id"],
        "title": "ErrorBody",
        "type": "object"
      },
      "MessageOut": {
        "properties": {
          "citations": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Citation"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "The documents an assistant answer cites; null for user messages.",
            "title": "Citations"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": ["user", "assistant"],
            "title": "Role",
            "type": "string"
          }
        },
        "required": ["id", "role", "content", "citations", "created_at"],
        "title": "MessageOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Team Assistant — api",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Health endpoint reporting observability state.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/info": {
      "get": {
        "description": "Consolidated status + version + runtime report for this service.\n\nExtends the /health shape with the build version and runtime/system\nmetadata. Reachable only via the BFF (web) on the internal network.",
        "operationId": "info_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Info Info Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Info"
      }
    },
    "/ping": {
      "get": {
        "description": "Liveness greeting endpoint.",
        "operationId": "ping_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ping Ping Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ping"
      }
    },
    "/v1/conversations": {
      "get": {
        "description": "Conversations, most recently updated first.",
        "operationId": "list_conversations_v1_conversations_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          }
        },
        "summary": "List Conversations",
        "tags": ["conversations"]
      },
      "post": {
        "description": "Start a conversation. The body is optional.",
        "operationId": "create_conversation_v1_conversations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ConversationCreate"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          }
        },
        "summary": "Create Conversation",
        "tags": ["conversations"]
      }
    },
    "/v1/conversations/{conversation_id}": {
      "get": {
        "description": "One conversation with its messages, oldest first. A malformed id is a 422.",
        "operationId": "read_conversation_v1_conversations__conversation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such conversation (`not_found`)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          }
        },
        "summary": "Read Conversation",
        "tags": ["conversations"]
      }
    }
  }
}
